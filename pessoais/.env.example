# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ============================================
DB_URL=jdbc:postgresql://localhost:5432/financas_pessoais
DB_USER=postgres
DB_PASSWORD=sua_senha_segura_aqui

# ============================================
# CONFIGURAÇÃO JWT
# ============================================
JWT_KEY=constituicao-financeira-chave-super-segura-32chars
