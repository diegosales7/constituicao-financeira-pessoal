# Exemplo .env para deploy simples em VM Ubuntu na OCI
# NÃO comite o arquivo real .env com senhas

POSTGRES_DB=financas_pessoais
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-essa-senha

# URL interna do banco (nome do serviço do compose)
DB_URL=jdbc:postgresql://postgres:5432/financas_pessoais
DB_USERNAME=postgres
DB_PASSWORD=troque-essa-senha

JWT_SECRET=troque-por-uma-chave-com-32-caracteres-ou-mais
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Origens permitidas para CORS (adicionar o IP público da VM quando conhecido)
CORS_ALLOWED_ORIGINS=http://localhost,http://IP_PUBLICO_DA_VM
